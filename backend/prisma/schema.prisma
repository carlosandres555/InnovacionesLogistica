// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum definitions
enum UserRole {
  ADMIN
  COMPANY_OWNER
  DRIVER
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

// Users
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole @default(CUSTOMER)
  company   Company? @relation("CompanyOwner", fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  // Relations for assigned shipments (drivers)
  assignedShipments Shipment[] @relation("AssignedDriver")

  // Activity tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  @@index([email])
  @@index([companyId])
  @@index([role])
}

// Companies
model Company {
  id             String   @id @default(cuid())
  name           String
  description    String?
  email          String   @unique
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  owner          User     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String   @unique
  logo           String?
  isActive       Boolean  @default(true)

  // Relations
  employees      User[]
  vehicles       Vehicle[]
  shipments      Shipment[]
  locations      Location[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

// Vehicles
model Vehicle {
  id             String         @id @default(cuid())
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  plate          String         @unique
  model          String
  capacity       Float          // kg
  status         VehicleStatus  @default(ACTIVE)
  lastLocation   String?
  currentDriver  User?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId       String?
  gpsDevice      String?        // GPS device ID for tracking
  photo          String?

  shipments      Shipment[]
  locations      Location[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([plate])
  @@index([status])
  @@index([driverId])
}

// Shipments/Orders
model Shipment {
  id             String         @id @default(cuid())
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  trackingNumber String         @unique
  status         ShipmentStatus @default(PENDING)

  // Origin
  originAddress  String
  originLat      Float?
  originLng      Float?

  // Destination
  destAddress    String
  destLat        Float?
  destLng        Float?

  // Cargo
  description    String
  weight         Float          // kg
  dimensions     String?        // LxWxH
  value          Float?         // monetary value

  // Tracking
  assignedDriver User?          @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId       String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId      String?

  // Timeline
  scheduledDate  DateTime?
  pickupTime     DateTime?
  deliveryTime   DateTime?
  estimatedTime  DateTime?

  // Additional
  notes          String?
  photo          String?        // delivery proof

  // Relations
  locations      Location[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([trackingNumber])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

// GPS Locations / Tracking History
model Location {
  id             String   @id @default(cuid())
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId     String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String

  latitude       Float
  longitude      Float
  accuracy       Float?
  altitude       Float?
  speed          Float?          // km/h
  heading        Float?          // degrees (0-360)

  address        String?
  notes          String?

  timestamp      DateTime @default(now())

  @@index([shipmentId])
  @@index([vehicleId])
  @@index([companyId])
  @@index([timestamp])
  @@index([latitude, longitude])
}

// File uploads tracking
model FileUpload {
  id             String   @id @default(cuid())
  shipmentId     String?
  companyId      String?

  fileName       String
  fileUrl        String   @unique  // S3 URL
  fileSize       Int              // bytes
  fileType       String           // MIME type

  uploadedAt     DateTime @default(now())
  expiresAt      DateTime?

  @@index([shipmentId])
  @@index([companyId])
  @@index([uploadedAt])
}
