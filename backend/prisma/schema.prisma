generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALISTA
  IN_HOUSE
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  password String
  firstName String
  lastName String
  phone String?
  role UserRole @default(CUSTOMER)
  permissions Json? @default("{\"modules\":[\"dashboard\"]}")
  isActive Boolean @default(true)
  ownedCompany Company? @relation("CompanyOwner")
  company Company? @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?
  assignedShipments Shipment[] @relation("AssignedDriver")
  drivingVehicles Vehicle[] @relation("CurrentDriver")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
  @@index([email])
  @@index([companyId])
}

model Company {
  id String @id @default(cuid())
  name String
  description String?
  email String @unique
  phone String?
  website String?
  address String?
  city String?
  state String?
  zipCode String?
  country String?
  owner User @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @unique
  logo String?
  isActive Boolean @default(true)
  employees User[] @relation("CompanyEmployees")
  vehicles Vehicle[]
  shipments Shipment[]
  locations Location[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([email])
}

model Vehicle {
  id String @id @default(cuid())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  plate String @unique
  model String
  capacity Float
  status VehicleStatus @default(ACTIVE)
  lastLocation String?
  currentDriver User? @relation("CurrentDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?
  gpsDevice String?
  photo String?
  shipments Shipment[]
  locations Location[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([plate])
}

model Shipment {
  id String @id @default(cuid())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  trackingNumber String @unique
  status ShipmentStatus @default(PENDING)
  originAddress String
  originLat Float?
  originLng Float?
  destAddress String
  destLat Float?
  destLng Float?
  description String
  weight Float
  dimensions String?
  value Float?
  assignedDriver User? @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?
  scheduledDate DateTime?
  pickupTime DateTime?
  deliveryTime DateTime?
  estimatedTime DateTime?
  notes String?
  photo String?
  locations Location[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([status])
  @@index([trackingNumber])
}

model Location {
  id String @id @default(cuid())
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  latitude Float
  longitude Float
  accuracy Float?
  altitude Float?
  speed Float?
  heading Float?
  address String?
  notes String?
  timestamp DateTime @default(now())
  @@index([shipmentId])
  @@index([vehicleId])
  @@index([companyId])
}

model FileUpload {
  id String @id @default(cuid())
  shipmentId String?
  companyId String?
  fileName String
  fileUrl String @unique
  fileSize Int
  fileType String
  uploadedAt DateTime @default(now())
  expiresAt DateTime?
}
