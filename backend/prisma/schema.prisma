generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALISTA
  IN_HOUSE
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  password String
  firstName String
  lastName String
  phone String?
  role UserRole @default(CUSTOMER)
  permissions Json? @default("{\"modules\":[\"dashboard\"]}")
  isActive Boolean @default(true)
  ownedCompany Company? @relation("CompanyOwner")
  company Company? @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?
  contractor Company? @relation("ContractorInHouse", fields: [contractorId], references: [id], onDelete: SetNull)
  contractorId String? // Para usuarios IN_HOUSE: empresa contratista asignada
  assignedShipments Shipment[] @relation("AssignedDriver")
  drivingVehicles Vehicle[] @relation("CurrentDriver")
  smUploads SMUpload[]
  entregaStatusUpdates EntregaDeliveryStatus[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
  @@index([email])
  @@index([companyId])
  @@index([contractorId])
}

model Company {
  id String @id @default(cuid())
  name String
  description String?
  email String @unique
  phone String?
  website String?
  address String?
  city String?
  state String?
  zipCode String?
  country String?
  owner User? @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String? @unique
  logo String?
  isActive Boolean @default(true)
  employees User[] @relation("CompanyEmployees")
  inHouseUsers User[] @relation("ContractorInHouse") // Usuarios IN_HOUSE asignados a esta contratista
  vehicles Vehicle[]
  shipments Shipment[]
  locations Location[]
  smUploads SMUpload[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([email])
}

model Vehicle {
  id String @id @default(cuid())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  plate String @unique
  model String
  capacity Float
  status VehicleStatus @default(ACTIVE)
  lastLocation String?
  currentDriver User? @relation("CurrentDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?
  gpsDevice String?
  photo String?
  shipments Shipment[]
  locations Location[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([plate])
}

model Shipment {
  id String @id @default(cuid())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  trackingNumber String @unique
  status ShipmentStatus @default(PENDING)
  originAddress String
  originLat Float?
  originLng Float?
  destAddress String
  destLat Float?
  destLng Float?
  description String
  weight Float
  dimensions String?
  value Float?
  assignedDriver User? @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?
  scheduledDate DateTime?
  pickupTime DateTime?
  deliveryTime DateTime?
  estimatedTime DateTime?
  notes String?
  photo String?
  locations Location[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([status])
  @@index([trackingNumber])
}

model Location {
  id String @id @default(cuid())
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  latitude Float
  longitude Float
  accuracy Float?
  altitude Float?
  speed Float?
  heading Float?
  address String?
  notes String?
  timestamp DateTime @default(now())
  @@index([shipmentId])
  @@index([vehicleId])
  @@index([companyId])
}

model FileUpload {
  id String @id @default(cuid())
  shipmentId String?
  companyId String?
  fileName String
  fileUrl String @unique
  fileSize Int
  fileType String
  uploadedAt DateTime @default(now())
  expiresAt DateTime?
}

model SMUpload {
  id String @id @default(cuid())
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?
  fileName String
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  status String @default("completed") // completed, pending, error
  totalRecords Int @default(0)
  errorMessage String?
  details SMDetail[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([createdAt])
}

model SMDetail {
  id String @id @default(cuid())
  smUpload SMUpload @relation(fields: [smUploadId], references: [id], onDelete: Cascade)
  smUploadId String
  fecha String
  ruta String
  ciudad String
  cargas String
  nombreCliente String
  codCliente String
  secuencia String
  alqueria Int @default(0)
  yogurt Int @default(0)
  quesos Int @default(0)
  totalGeneral Int @default(0)
  numCarga String // Código de vehículo/transporte (NO único, puede haber múltiples entregas)
  ordenCompra String?
  deliveryStatus EntregaDeliveryStatus? // Estado de la entrega
  createdAt DateTime @default(now())
  @@index([smUploadId])
  @@index([numCarga])
  @@index([fecha])
}

model DeliveryStatus {
  id String @id @default(cuid())
  nombre String @unique // EXITOSA, PARCIAL, NO EXITOSA
  descripcion String?
  color String? // Para UI: green, orange, red
  razones DeliveryStatusReason[] // Motivos asociados
  entregas EntregaDeliveryStatus[]
  createdAt DateTime @default(now())
}

model DeliveryStatusReason {
  id String @id @default(cuid())
  status DeliveryStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  statusId String
  nombre String // ej: "Producto dañado", "Cliente no disponible"
  descripcion String?
  entregas EntregaDeliveryStatus[] // Entregas que tienen este motivo
  createdAt DateTime @default(now())
  @@unique([statusId, nombre]) // No permitir motivos duplicados por estado
  @@index([statusId])
}

model EntregaDeliveryStatus {
  id String @id @default(cuid())
  entrega SMDetail @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  entregaId String @unique
  status DeliveryStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  statusId String
  reason DeliveryStatusReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  reasonId String?
  observaciones String?
  recogioDevoluccion Boolean @default(false) // Indica si recogió devolución
  fechaEntrega DateTime? // Fecha real de entrega (para entregas atrasadas sin fecha conocida)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedAt DateTime @updatedAt
  @@index([entregaId])
  @@index([statusId])
  @@index([reasonId])
}

model RolePermission {
  id String @id @default(cuid())
  role String @unique // ADMIN, ANALISTA, IN_HOUSE, CUSTOMER
  modules String[] @default([]) // Array de módulos: dashboard, trafico, historicoRutero, cargaInformacion
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
